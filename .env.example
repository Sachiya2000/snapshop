# Copy to .env.local and fill in. Never commit .env.local.

# Meta Model API key: https://dev.meta.ai -> API keys -> Create API key
MODEL_API_KEY=

# Optional: override the Muse Spark model (default muse-spark-1.3).
# META_SPARK_MODEL=muse-spark-1.3

# Neon Postgres connection string (use the pooled URL, with ?sslmode=require)
DATABASE_URL=

# Which provider writes listings: "meta" (Muse Spark via Model API, default)
# or "openai-compatible" (e.g. self-hosted Muse Spark Open behind vLLM).
# LISTING_PROVIDER=meta
# OPEN_MODEL_BASE_URL=http://localhost:8000/v1
# OPEN_MODEL_NAME=
# OPEN_MODEL_API_KEY=

# Image storage. Unset: local ./uploads folder (dev only). On Vercel, connect a
# private Blob store to the project; it sets this for you.
# BLOB_READ_WRITE_TOKEN=
